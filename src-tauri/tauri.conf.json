{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "coreforge",
  "version": "0.1.0",
  "identifier": "com.coreforge.app",
  "build": {
    "beforeDevCommand": "cargo build --manifest-path src-tauri/Cargo.toml --bin coreforge-helper --features helper && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --release --bin coreforge-helper --features helper",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CoreForge",
        "width": 1200,
        "height": 750
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Hardware toolkit for Linux",
    "longDescription": "System information, live sensors, CPU/RAM/GPU stress tests, benchmarks, disk and network diagnostics, fan curves and RGB control.",
    "copyright": "Copyright (c) 2026 Gustavo (GustavoReset) and CoreForge contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "depends": [
          "pkexec | policykit-1"
        ],
        "recommends": [
          "smartmontools",
          "lm-sensors",
          "power-profiles-daemon",
          "libnotify-bin"
        ],
        "section": "utils",
        "files": {
          "/usr/libexec/coreforge/coreforge-helper": "target/release/coreforge-helper",
          "/usr/share/polkit-1/actions/org.coreforge.helper.policy": "packaging/org.coreforge.helper.policy",
          "/usr/share/metainfo/com.coreforge.app.metainfo.xml": "packaging/com.coreforge.app.metainfo.xml"
        },
        "desktopTemplate": "packaging/coreforge.desktop"
      },
      "rpm": {
        "files": {
          "/usr/libexec/coreforge/coreforge-helper": "target/release/coreforge-helper",
          "/usr/share/polkit-1/actions/org.coreforge.helper.policy": "packaging/org.coreforge.helper.policy",
          "/usr/share/metainfo/com.coreforge.app.metainfo.xml": "packaging/com.coreforge.app.metainfo.xml"
        },
        "desktopTemplate": "packaging/coreforge.desktop",
        "depends": [
          "polkit"
        ]
      }
    }
  }
}
